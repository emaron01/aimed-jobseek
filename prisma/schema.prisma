  name              String
  slug              String                  @unique
  status            OrganizationStatus      @default(ACTIVE)
  accountType       OrganizationAccountType @default(INDIVIDUAL)
  /// IANA timezone for daily quota windows (e.g. America/New_York).
  timezone          String                  @default("UTC")
  suspendedAt       DateTime?
  suspendedReason   String?
  /// Soft reference to the platform operator who suspended; no FK (ops users may be deleted).
  suspendedByUserId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  memberships                   OrganizationMembership[]
  products                      Product[]
  offers                        Offer[]
  icps                          Icp[]
  personas                      Persona[]
  personaTemplates              PersonaTemplate[]
  consultationSessions          ConsultationSession[]
  consultationTurns             ConsultationTurn[]
  consultationAssessments       ConsultationAssessment[]
  consultationProposals         ConsultationProposal[]
  consultationStatements        ConsultationStatement[]
  applicationSummaries          ApplicationSummary[]
  applicationAssets             ApplicationAsset[]
  interviewStages               InterviewStage[]
  interviewStageInterviewers    InterviewStageInterviewer[]
  interviewStageGuides          InterviewStageGuide[]
  profileStories                ProfileStory[]
  contactLists                  ContactList[]
  contacts                      Contact[]
  companies                     Company[]
  companyResearch               CompanyResearch[]
  contactResearch               ContactResearch[]
  icpCriteria                   IcpCriterion[]
  personaCriteria               PersonaCriterion[]
  contactScores                 ContactScore[]
  scoringRuns                   ScoringRun[]
  titleSuggestions              TitleSuggestion[]
  productTitleDismissals        ProductTitleDismissal[]
  campaigns                     Campaign[]
  campaignPersonas              CampaignPersona[]
  campaignContacts              CampaignContact[]
  emailDrafts                   EmailDraft[]
  usagePolicy                   OrganizationUsagePolicy?
  researchPolicy                ResearchPolicy?
  userUsageOverrides            UserUsageOverride[]
  usageEvents                   UsageEvent[]
  usageQuotaLedgers             UsageQuotaLedger[]
  usageAlertLedgers             UsageAlertLedger[]
  creditGrants                  OrganizationCreditGrant[]
  companyResearchCredits        CompanyResearchCredit[]
  qualificationOverrides        QualificationBucketOverride[]
  invitations                   OrganizationInvitation[]
  billingProfile                OrganizationBillingProfile?
  transactionalEmailEvents      TransactionalEmailEvent[]
  activeForUsers                User[]                        @relation("ActiveOrganization")
  productSources                ProductSource[]
  productSourceBlobs            ProductSourceBlob[]
  productEvidenceBundles        ProductEvidenceBundle[]
  productSetupRuns              ProductSetupRun[]
  personaSources                PersonaSource[]
  personaEvidenceBundles        PersonaEvidenceBundle[]
  personaSetupRuns              PersonaSetupRun[]
  voiceSamples                  VoiceSample[]
  emailSignatures               EmailSignature[]
  mailboxConnections            MailboxConnection[]
  mailboxOAuthStates            MailboxOAuthState[]
  emailSendRecords              EmailSendRecord[]
  emailSuppressions             EmailSuppression[]
  contactListMemberships        ContactListMembership[]
  contactMergeAudits            ContactMergeAudit[]
  cadencePolicy                 OrganizationCadencePolicy?
  dailyDigestSends              DailyDigestSend[]
  researchRuns                  ResearchRun[]
  referralCode                  OrganizationReferralCode?
  referralReward                OrganizationReferralReward?
  referralRedemptionsAsReferrer ReferralRedemption[]          @relation("ReferrerRedemptions")
  referralRedemptionsAsReferee  ReferralRedemption[]          @relation("RefereeRedemptions")
  supportTickets                SupportTicket[]
  jobRequirements               JobRequirement[]
  applicationFits               ApplicationFit[]
  presentationPlans             ApplicationPresentationPlan[]
  applicationJobs               ApplicationJob[]

  @@index([status])
  @@index([accountType])
  @@index([createdAt])
  @@index([suspendedAt])
}

/// Versioned AI model rates for estimated COGS (Phase B). Lookup: latest effectiveFrom <= event time.
model AiModelRate {
  id                  String   @id @default(cuid())
  provider            String
  model               String
  /// USD per 1M uncached input tokens.
  inputPer1MUsd       Decimal  @db.Decimal(12, 6)
  /// USD per 1M cached input tokens.
  cachedInputPer1MUsd Decimal  @default(0) @db.Decimal(12, 6)
  /// USD per 1M cache-write tokens (OpenAI bills writes at 1.25× uncached input).
  cacheWritePer1MUsd  Decimal  @default(0) @db.Decimal(12, 6)
  /// USD per 1M output tokens.
  outputPer1MUsd      Decimal  @db.Decimal(12, 6)
  /// USD per web_search tool call (search content tokens still billed via input).
  webSearchPerCallUsd Decimal  @db.Decimal(12, 6)
  effectiveFrom       DateTime
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([provider, model, effectiveFrom])
  @@index([provider, model, effectiveFrom])
  @@index([effectiveFrom])
}

/// Manual provider-dashboard spend vs our estimated spend (drift flag when |Δ|/actual > 15%).
model ProviderSpendReconciliation {
  id                  String   @id @default(cuid())
  /// e.g. openai, anthropic, or ALL for blended.
  provider            String
  periodStart         DateTime
  periodEnd           DateTime
  providerReportedUsd Decimal  @db.Decimal(14, 4)
  estimatedUsd        Decimal  @db.Decimal(14, 4)
  notes               String?
  createdByUserId     String
  createdAt           DateTime @default(now())

  createdBy User @relation("SpendReconciliationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([provider, periodEnd])
  @@index([createdAt])
  @@index([createdByUserId])
}

model User {
  id                   String       @id @default(cuid())
  authUserId           String?      @unique
  email                String       @unique
  emailNormalized      String       @unique
  firstName            String?
  lastName             String?
  name                 String?
  emailVerifiedAt      DateTime?
  platformRole         PlatformRole @default(NONE)
  activeOrganizationId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  activeOrganization             Organization?                 @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  memberships                    OrganizationMembership[]
  usageOverrides                 UserUsageOverride[]
  usageEvents                    UsageEvent[]
  usageQuotaLedgers              UsageQuotaLedger[]
  qualificationOverrides         QualificationBucketOverride[]
  invitationsSent                OrganizationInvitation[]      @relation("InvitedBy")
  companyResearchInitiated       CompanyResearch[]             @relation("ResearchInitiatedBy")
  companyResearchFirstIntroduced CompanyResearch[]             @relation("ResearchFirstIntroducedBy")
  adminAuditEvents               AdminAuditEvent[]
  transactionalEmailEvents       TransactionalEmailEvent[]
  voiceSamples                   VoiceSample[]
  emailSignatures                EmailSignature[]
  sentEmailDrafts                EmailDraft[]                  @relation("EmailDraftSentBy")
  mailboxConnections             MailboxConnection[]
  mailboxOAuthStates             MailboxOAuthState[]
  emailSendRecords               EmailSendRecord[]
  titleSuggestionsResolved       TitleSuggestion[]             @relation("TitleSuggestionResolvedBy")
  productTitleDismissals         ProductTitleDismissal[]       @relation("ProductTitleDismissedBy")
  emailSuppressionsCreated       EmailSuppression[]            @relation("EmailSuppressedBy")
  emailSuppressionsReleased      EmailSuppression[]            @relation("EmailReleasedBy")
  contactListsCreated            ContactList[]                 @relation("ContactListCreatedBy")
  contactsCreated                Contact[]                     @relation("ContactCreatedBy")
  ownedContactLists              ContactList[]                 @relation("ContactListOwner")
  submittedSupportTickets        SupportTicket[]               @relation("SupportTicketSubmitter")
  authoredSupportNotes           SupportTicketNote[]           @relation("SupportTicketNoteAuthor")
  ownedContacts                  Contact[]                     @relation("ContactOwner")
  contactMembershipsAdded        ContactListMembership[]       @relation("ContactMembershipAddedBy")
  sequenceStopsInitiated         CampaignContact[]             @relation("SequenceStoppedBy")
  ownedCampaigns                 Campaign[]                    @relation("CampaignOwner")
  applicationFitOverrides        ApplicationFit[]              @relation("ApplicationFitOverride")
  creditGrantsIssued             OrganizationCreditGrant[]     @relation("CreditGrantedBy")
  companyResearchCredits         CompanyResearchCredit[]       @relation("CompanyResearchCreditUser")
  spendReconciliationsCreated    ProviderSpendReconciliation[] @relation("SpendReconciliationCreatedBy")
  /// IANA timezone for digest windows. Falls back to organization timezone when null.
  timezone                       String?
  digestEnabled                  Boolean                       @default(true)
  /// Local send time HH:mm (24h) in the user's timezone.
  digestSendTimeLocal            String                        @default("08:00")
  dailyDigestSends               DailyDigestSend[]
  researchRunsInitiated          ResearchRun[]                 @relation("ResearchRunInitiatedBy")
  applicationJobsInitiated       ApplicationJob[]              @relation("ApplicationJobInitiatedBy")
  platformSettingsUpdated        PlatformSetting[]             @relation("PlatformSettingUpdatedBy")
  eulaVersionsCreated            EulaVersion[]                 @relation("EulaVersionCreatedBy")
  eulaAcceptances                UserEulaAcceptance[]

  @@index([platformRole])
  @@index([activeOrganizationId])
}

/// Pasted writing samples for one user inside one organization. Never org-wide.
model VoiceSample {
  id             String                @id @default(cuid())
  organizationId String
  userId         String
  label          String
  sampleText     String
  provenance     VoiceSampleProvenance @default(PASTED)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId])
  @@index([organizationId, userId, createdAt])
}

/// One plain-text email signature per user per organization. Appended at send, never generated.
model EmailSignature {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// Plain text for deeplink handoff (mailto cannot carry HTML).
  body           String
  /// Optional HTML for Connected Send (logos, styled blocks). Null = text-only Graph send.
  htmlBody       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model MailboxConnection {
  id                    String                  @id @default(cuid())
  organizationId        String
  userId                String
  provider              MailboxProvider
  status                MailboxConnectionStatus @default(CONNECTED)
  mailboxAddress        String
  providerTenantId      String?
  providerAccountId     String
  encryptedAccessToken  String
  encryptedRefreshToken String
  accessTokenExpiresAt  DateTime
  grantedScopesJson     Json
  lastErrorCode         String?
  connectedAt           DateTime                @default(now())
  refreshedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, status])
}

model MailboxOAuthState {
  id                    String          @id @default(cuid())
