model OrganizationMembership {
  id               String         @id @default(cuid())
  organizationId   String
  userId           String
  role             MembershipRole @default(MEMBER)
  isBillingContact Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

/// Billing state + ops contact. Never store card data, address, or tax PII.
/// Phase C attaches Stripe by filling stripe* fields and flipping planCode/status — no reshape.
model OrganizationBillingProfile {
  id                             String             @id @default(cuid())
  organizationId                 String             @unique
  billingEmail                   String?
  /// Product plan code. New rows use STANDARD | TEAM | ENTERPRISE; COMPED/PREMIUM remain readable legacy values.
  /// Payment collection is separate: FREE = comped, Stripe ids = self-serve, ENTERPRISE = invoice-managed.
  planCode                       String             @default("FREE")
  billingStatus                  BillingStatus      @default(FREE)
  /// Stripe Customer id (cus_…) — null while free / pre-Stripe.
  stripeCustomerId               String?
  /// Stripe Subscription id (sub_…) — null while free / pre-Stripe.
  stripeSubscriptionId           String?
  /// Base subscription Price id (price_…) — identifiers only. Grandfathered: may differ from env catalog.
  stripePriceId                  String?
  /// Base subscription Product id (prod_…) — identifiers only.
  stripeProductId                String?
  /// List unit_amount from the Price they are on (cents). Not the env catalog price.
  stripePriceUnitAmountCents     Int?
  /// ISO currency from the Price (e.g. usd).
  stripePriceCurrency            String?
  /// Recurring interval from the Price (month | year | week | day).
  stripePriceInterval            String?
  /// Sum of percent_off coupons on the subscription (display). Null = no %-off.
  stripeDiscountPercentOff       Float?
  /// Sum of amount_off coupons on the subscription (cents). Null = none.
  stripeDiscountAmountOffCents   Int?
  /// First coupon id applied (coupon_…) — identifier only.
  stripeCouponId                 String?
  /// Unit amount after mirrored discounts (cents) — what they effectively pay per interval.
  stripeEffectiveUnitAmountCents Int?
  /// Purchased / Stripe subscription quantity (seats).
  seatQuantity                   Int                @default(1)
  /// Invite cap. TEAM defaults to plan max (10). ENTERPRISE overridable by SUPER_ADMIN.
  maxSeats                       Int                @default(1)
  currentPeriodEnd               DateTime?
  trialEndsAt                    DateTime?
  /// After payment failure: lock when now >= gracePeriodEndsAt (7-day grace).
  gracePeriodEndsAt              DateTime?
  lockReason                     BillingLockReason?
  cancelAtPeriodEnd              Boolean            @default(false)
  canceledAt                     DateTime?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([billingStatus])
  @@index([planCode])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

/// Lazy Individual referral promo code (created on first open of referral UI).
model OrganizationReferralCode {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  /// Human-readable Checkout promotion code (e.g. JOIN-K7Q2).
  code                  String   @unique
  /// Stripe Promotion Code id (promo_…).
  stripePromotionCodeId String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripePromotionCodeId])
}

/// Referrer's cumulative reward rate (advanced only when a referee first becomes ACTIVE).
model OrganizationReferralReward {
  id                      String   @id @default(cuid())
  organizationId          String   @unique
  /// Counted ACTIVE referrals (keeps growing after the 50% cap).
  successfulReferralCount Int      @default(0)
  /// min(50, count * 10) — 0 | 10 | 20 | 30 | 40 | 50.
  rewardPercent           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ReferralRedemptionStatus {
  ATTRIBUTED
  COUNTED
}

/// One lifetime referral credit per referee organization (idempotent on subscription too).
model ReferralRedemption {
  id                      String                   @id @default(cuid())
  referrerOrganizationId  String
  /// Unique: a referee org can only credit a referrer once.
  refereeOrganizationId   String                   @unique
  stripePromotionCodeId   String
  /// Unique: webhook replay on the same subscription cannot double-count.
  stripeSubscriptionId    String                   @unique
  refereeEmailNormalized  String
  referrerEmailNormalized String
  status                  ReferralRedemptionStatus @default(ATTRIBUTED)
  attributedAt            DateTime                 @default(now())
  countedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  referrer Organization @relation("ReferrerRedemptions", fields: [referrerOrganizationId], references: [id], onDelete: Cascade)
  referee  Organization @relation("RefereeRedemptions", fields: [refereeOrganizationId], references: [id], onDelete: Cascade)

  @@index([referrerOrganizationId])
  @@index([stripePromotionCodeId])
  @@index([refereeEmailNormalized])
  @@index([status])
}

/// One-time company research capacity packs ($30 / 100). Expire 12 months after grant.
/// Never store card/PII — Stripe payment/checkout ids only for idempotent grant.
/// Standard: userId null (org pool). Team/Enterprise: userId set (personal allowance).
model CompanyResearchCredit {
  id                      String   @id @default(cuid())
  organizationId          String
  /// When set, packs apply only to this user's first-introducer allowance (TEAM/ENTERPRISE).
  userId                  String?
  /// Companies added to the effective research allowance while unexpired.
  quantity                Int
  grantedAt               DateTime @default(now())
  /// grantedAt + 12 months. Unexpired rows sum into effective allowance.
  expiresAt               DateTime
  /// Stripe Checkout Session id (cs_…) when purchased via one-time Checkout.
  stripeCheckoutSessionId String?  @unique
  /// Stripe PaymentIntent id (pi_…) when available — idempotency backup.
  stripePaymentIntentId   String?  @unique
  createdAt               DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("CompanyResearchCreditUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, expiresAt])
  @@index([organizationId, userId])
  @@index([userId])
}

/// Webhook idempotency ledger. Store event id + type only — never the raw payload.
model StripeWebhookEvent {
  id            String   @id @default(cuid())
  /// Stripe event id (evt_…) — unique so double delivery is a no-op.
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

/// Manual USD credit grants by platform SUPER_ADMIN (ops ledger; not Stripe company packs).
model OrganizationCreditGrant {
  id              String   @id @default(cuid())
  organizationId  String
  grantedByUserId String
  amountUsd       Decimal  @db.Decimal(12, 2)
  reason          String
  note            String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("CreditGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([grantedByUserId])
}

/// Idempotency ledger for 80% usage-limit warning emails.
model UsageAlertLedger {
  id               String             @id @default(cuid())
  organizationId   String
  resource         UsageAlertResource
  /// Calendar day (or entitlement period) key, e.g. 2026-08-27.
  periodKey        String
  thresholdPercent Int
  sentAt           DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, resource, periodKey, thresholdPercent])
  @@index([organizationId])
  @@index([organizationId, resource, periodKey])
}

/// Organization-level usage limits. Defaults are DB-backed configuration, not product constants.
/// Organization-level email cadence intervals (gaps stored; UI shows cumulative days).
model OrganizationCadencePolicy {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  /// Gap in days after email 1 before email 2 (cumulative day 9 by default).
  day2IntervalDays   Int      @default(9)
  /// Gap after email 2 before email 3 (cumulative day 15 = 9+6 by default).
  day3IntervalDays   Int      @default(6)
  /// Gap after email 3 before email 4 (cumulative day 30 = 9+6+15 by default).
  day4IntervalDays   Int      @default(15)
  /// Gap after email 4+ for repeat sends (every 30 days by default).
  repeatIntervalDays Int      @default(30)
  /// Max emails in sequence including initial. Null = unlimited (explicit opt-in).
  maxSequenceEmails  Int?     @default(4)
  /// Application reminder days from the Applied date, or first sent outreach.
  /// Null means no reminder for that slot. Blank in the UI is stored as null, never 0.
  reminderDay3         Int?     @default(3)
  reminderDay7         Int?     @default(7)
  reminderEmail4Days   Int?
  reminderRepeatDays   Int?
  /// Hours after a stage before a thank-you reminder is due.
  interviewThankYouHours Int @default(24)
  /// Business days after a stage when no expected decision date is set.
  interviewCheckInBusinessDays Int @default(5)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Idempotency ledger for per-user daily cadence digest sends.
model DailyDigestSend {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// Calendar day key in the user's timezone, e.g. 2026-08-26.
  periodKey      String
  dueCount       Int
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([organizationId])
  @@index([userId])
  @@index([periodKey])
}

model OrganizationUsagePolicy {
  id                           String   @id @default(cuid())
  organizationId               String   @unique
  activeResearchedCompanyLimit Int
  dailyEmailGenerationLimit    Int
  dailyEmailSendWarningLimit   Int      @default(150)
  dailyEmailSendLimit          Int      @default(250)
  /// Hard monthly send cap (STANDARD = 1000). Null = no monthly hard block (e.g. FREE comps).
  monthlyEmailSendLimit        Int?
  emailDeeplinkMaxUrlLength    Int      @default(1800)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Organization-level research depth / freshness. Editable; not hard-coded forever.
model ResearchPolicy {
  id                                 String   @id @default(cuid())
  organizationId                     String   @unique
  maxSearchQueriesPerCompany         Int
  maxSourcesPerCompany               Int
  researchFreshnessDays              Int
  /// Platform-operator toggle only — per-contact AI cost; not exposed in org settings.
  contactResearchEnabled             Boolean  @default(false)
  /// Progressive contact-role research limits (criteria-aware; not hard-coded forever).
  maxSearchQueriesPerContact         Int      @default(2)
  maxSourcesPerContact               Int      @default(6)
  contactResearchFreshnessDays       Int      @default(90)
  /// Product URL/web source reacquisition freshness. Default written at create: 120.
  productSourceResearchFreshnessDays Int      @default(120)
  maxSearchQueriesPerProduct         Int      @default(3)
  maxSourcesPerProduct               Int      @default(12)
  maxSearchQueriesPerPersona         Int      @default(2)
  maxSourcesPerPersona               Int      @default(8)
  personaResearchFreshnessDays       Int      @default(90)
  /// Max criteria projected from Persona AI signal arrays before review cap.
  maxProjectedPersonaCriteria        Int      @default(15)
  /// Max TARGETED_SEARCH ICP criteria per ICP (enforce at save — never silently drop).
  maxTargetedSearchCriteriaPerIcp    Int      @default(3)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Optional per-user overrides. Null field = inherit OrganizationUsagePolicy.
model UserUsageOverride {
  id                           String   @id @default(cuid())
  organizationId               String
  userId                       String
  activeResearchedCompanyLimit Int?
  dailyEmailGenerationLimit    Int?
  dailyEmailSendWarningLimit   Int?
  dailyEmailSendLimit          Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

/// Immutable usage/telemetry events. Authoritative for metering; do not update/delete from app UX.
model UsageEvent {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  category       UsageCategory
  operation      UsageOperation
  provider       String?
  model          String?
  companyId      String?
  contactId      String?
  scoringRunId   String?
  campaignId     String?
  /// Links attempt/retry events for the same logical operation when used.
  operationId    String?
  inputTokens       Int?
  cachedInputTokens Int?
  cacheWriteTokens  Int?
  outputTokens      Int?
  webSearchCalls    Int?
  status         UsageEventStatus
  retryCount     Int              @default(0)
  durationMs     Int?
  /// Safe structured metadata only — never API keys or secrets.
  metadata       Json?
  occurredAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, userId])
  @@index([organizationId, category])
  @@index([organizationId, operation])
  @@index([operationId])
  @@index([companyId])
  @@index([scoringRunId])
}

/// Concurrency-safe daily (or period) quota consumption ledger.
model UsageQuotaLedger {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  resource       UsageResource
  /// Calendar day (or period) key in the Organization timezone, e.g. 2026-08-20.
  periodKey      String
  consumed       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, resource, periodKey])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, resource, periodKey])
}

model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  role            MembershipRole   @default(MEMBER)
  /// SHA-256 hash of the raw invitation token. Never store the raw token.
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@index([email])
}

model Product {
  id                       String                @id @default(cuid())
  organizationId           String
  name                     String
  description              String?
  valueProposition         String?
  averageOrderValue        Decimal?              @db.Decimal(12, 2)
  websiteUrl               String?
  /// Assisted-setup approval. Downstream scoring uses APPROVED authoritative fields.
  approvalStatus           ProductApprovalStatus @default(NOT_STARTED)
  setupStatus              ProductSetupStatus    @default(NOT_STARTED)
  approvedAt               DateTime?
  approvedByUserId         String?
  approvedEvidenceBundleId String?
  approvedSetupRunId       String?
  /// Extended approved product profile (problems, capabilities, etc.).
  profileJson              Json?
  /// Approved product messaging guidance (not scoring evidence).
  messagingJson            Json?
  /// Field paths the user edited — protected from silent overwrite.
  manuallyEditedFields     Json?
  /// Soft-archive: hidden from setup UI; preserves ScoringRun FK history.
  archivedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icps                   Icp[]
  personas               Persona[]
  campaigns              Campaign[]
  scoringRuns            ScoringRun[]
  titleSuggestions       TitleSuggestion[]
  titleDismissals        ProductTitleDismissal[]
  sources                ProductSource[]
  evidenceBundles        ProductEvidenceBundle[]
  setupRuns              ProductSetupRun[]
  personaSources         PersonaSource[]
  personaEvidenceBundles PersonaEvidenceBundle[]
  personaSetupRuns       PersonaSetupRun[]
  profileStories         ProfileStory[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
}

model Offer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  primaryCta     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
}

model Icp {
  id                            String    @id @default(cuid())
  organizationId                String
  productId                     String
  name                          String
  description                   String?
  /// Authoritative natural-language ICP definition (preserved; never overwritten by AI).
  definition                    String?
  additionalContext             String?
  targetIndustries              Json?
  minEmployees                  Int?
  maxEmployees                  Int?
  minRevenue                    Decimal?  @db.Decimal(14, 2)
  maxRevenue                    Decimal?  @db.Decimal(14, 2)
  targetGeographies             Json?
  requiredTechnologies          Json?
  positiveSignals               Json?
  negativeSignals               Json?
  notes                         String?
  /// Total annual compensation floor. Null when the seeker did not set one.
  targetAnnualEarningsMin       Decimal?  @db.Decimal(14, 2)
  /// Total annual compensation the seeker is aiming for, including OTE.
  targetAnnualEarningsTarget    Decimal?  @db.Decimal(14, 2)
  targetHourlyRateMin           Decimal?  @db.Decimal(14, 2)
  targetHourlyRateTarget        Decimal?  @db.Decimal(14, 2)
  compensationCurrency          String?
  /// FULL_TIME and/or PART_TIME. Null when unset.
  employmentTypes               Json?
  annualEarningsMinimumRequired Boolean   @default(false)
  hourlyRateMinimumRequired     Boolean   @default(false)
  employmentTypeRequired        Boolean   @default(false)
  interpretationVersion         Int       @default(1)
  interpretationPromptVersion   String?
  lastInterpretedAt             DateTime?
  /// Plain-language read-back of what interpretation understood (never overwrites definition).
  interpretationSummary         String?
  /// Explicitly named facts/constraints that could not be determined from the definition.
  interpretationUndetermined    String?
  /// Soft-archive: hidden from setup UI; preserves ScoringRun FK history.
  archivedAt                    DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  criteria        IcpCriterion[]
  campaigns       Campaign[]
  scoringRuns     ScoringRun[]
  applicationFits ApplicationFit[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([productId])
  @@index([organizationId, productId])
  @@index([organizationId, archivedAt])
}

/// Tenant-owned structured ICP criterion (AI-interpreted and/or manually edited).
model IcpCriterion {
  id                                String                  @id @default(cuid())
  organizationId                    String
  icpId                             String
  name                              String
  description                       String?
  criterionType                     String
  dataType                          CriterionDataType
  operator                          CriterionOperator
  targetValue                       Json?
  minValue                          Json?
  maxValue                          Json?
  allowedValues                     Json?
  importance                        CriterionImportance     @default(MEDIUM)
  isRequired                        Boolean                 @default(false)
  isDisqualifier                    Boolean                 @default(false)
  researchGuidance                  String?
  /// Why a proposed isRequired or isDisqualifier flag was downgraded. Null when the flag was kept or never proposed.
  strengthAdjustment                String?
  source                            CriterionSource         @default(AI_INTERPRETED)
  confidence                        ResearchConfidence?
  /// Where evidence is expected; app owns default (missing/unrecognized → TARGETED_SEARCH).
  evidenceClass                     CriterionEvidenceClass  @default(TARGETED_SEARCH)
  /// PRIMARY counts toward ICP fit; SECONDARY is an upside signal only.
  tier                              IcpCriterionTier        @default(PRIMARY)
  /// PRIMARY only. Confirmed failure disqualifies; unresolved is never a failure.
  isMandatory                       Boolean                 @default(false)
  /// When true, reinterpret preserves this evidenceClass even if the AI proposes another.
  evidenceClassLocked               Boolean                 @default(false)
  /// Required for TARGETED_SEARCH before the criterion is considered approved for scoring setup.
  targetedSearchDecision            TargetedSearchDecision?
  /// Fingerprint of name/description/type/class/operator/targets at approval time.
  /// Cleared (decision null) when the criterion changes materially.
  targetedSearchDecisionFingerprint String?
  targetedSearchDecidedAt           DateTime?
  /// When true, reinterpret must not overwrite this row without explicit user action.
  manuallyEdited                    Boolean                 @default(false)
  sortOrder                         Int                     @default(0)
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  icp          Icp          @relation(fields: [icpId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([icpId])
  @@index([organizationId, icpId])
  @@index([organizationId, icpId, sortOrder])
  @@index([organizationId, icpId, evidenceClass])
  @@index([organizationId, icpId, tier])
}

model Persona {
  id                          String                @id @default(cuid())
  organizationId              String
  productId                   String
  /// Set when this role belongs to one application. Null keeps older product-level rows.
  campaignId                  String?
  personaTemplateId           String?
  name                        String
  /// Authoritative natural-language persona / buyer-role definition (preserved).
  definition                  String?
  additionalContext           String?
  targetTitles                Json?
  department                  String?
  seniority                   String?
  responsibilities            String?
  painPoints                  String?
  desiredOutcomes             String?
  messagingNotes              String?
  interpretationVersion       Int                   @default(1)
  interpretationPromptVersion String?
  lastInterpretedAt           DateTime?
  approvalStatus              ProductApprovalStatus @default(NOT_STARTED)
  approvedAt                  DateTime?
  approvedByUserId            String?
  approvedEvidenceBundleId    String?
  approvedSetupRunId          String?
  manuallyEditedFields        Json?
  /// Links to a suggested buyer role key from a product setup run (optional).
  suggestionKey               String?
  whyThisPersonaMatters       String?
  /// Persona-specific messaging (not scoring evidence).
  personaMessagingJson        Json?
  /// Extended approved persona profile from staged Persona synthesis.
  profileJson                 Json?
  setupStatus                 PersonaSetupStatus    @default(NOT_STARTED)
  /// Set when identification or research changed after this role was built.
  staleAt                     DateTime?
  staleReason                 String?
  approvedPersonaSetupRunId   String?
  /// Soft-archive: hidden from setup UI; preserves ScoringRun FK history.
  archivedAt                  DateTime?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product                Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  application            Campaign?          @relation("ApplicationHiringTeam", fields: [campaignId], references: [id], onDelete: Cascade)
  personaTemplate        PersonaTemplate?   @relation(fields: [personaTemplateId], references: [id], onDelete: SetNull)
  criteria               PersonaCriterion[]
  campaigns              Campaign[]
  campaignPersonas       CampaignPersona[]
  scoringRuns            ScoringRun[]
  matchedScores          ContactScore[]     @relation("ContactScoreMatchedPersona")
  campaignContactsChosen CampaignContact[]  @relation("CampaignContactChosenPersona")
  setupRuns              PersonaSetupRun[]
  sources                PersonaSource[]
  applicationAssets      ApplicationAsset[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, name])
  @@index([productId])
  @@index([organizationId, productId])
  @@index([organizationId, archivedAt])
  @@index([campaignId])
  @@index([organizationId, campaignId])
  @@index([personaTemplateId])
}

/// Account-level starting point for a Hiring Team role. Instantiated per application.
model PersonaTemplate {
  id                 String   @id @default(cuid())
  organizationId     String
  /// Stable key for product-configured defaults. Null for templates the seeker added.
  templateKey        String?
  name               String
  likelyTitles       Json?
  department         String?
  whyThisRoleMatters String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personas     Persona[]

  @@unique([organizationId, templateKey])
  @@index([organizationId])
}

/// Tenant-owned product source material (URL, paste, upload, note).
model ProductSource {
  id                 String              @id @default(cuid())
  organizationId     String
  productId          String
  sourceType         ProductSourceType
  displayName        String
  originalUrl        String?
  normalizedUrlKey   String?
  filename           String?
  mimeType           String?
  byteSize           Int?
  acquisitionMethod  String
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  retrievedAt        DateTime?
  contentHash        String
  status             ProductSourceStatus @default(PENDING)
  errorSafe          String?
  extractedText      String?
  freshnessExpiresAt DateTime?
  metadataJson       Json?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  blob         ProductSourceBlob?

  @@unique([organizationId, productId, contentHash])
  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, productId])
  @@index([organizationId, contentHash])
  @@index([organizationId, normalizedUrlKey])
}

/// Durable binary storage for uploaded product materials (Postgres, not ephemeral disk).
model ProductSourceBlob {
  id             String   @id @default(cuid())
  organizationId String
  sourceId       String   @unique
  bytes          Bytes
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       ProductSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Versioned product evidence bundle — reusable acquisition asset.
model ProductEvidenceBundle {
  id                     String             @id @default(cuid())
  organizationId         String
  productId              String
  version                Int
  parentBundleId         String?
  correlationId          String
  status                 ProductSetupStatus @default(ACQUIRING)
  createdByUserId        String?
  createdAt              DateTime           @default(now())
  normalizedEvidenceJson Json?
  sourceIdsJson          Json
  urlResearchPerformed   Boolean            @default(false)
  webSearchQueriesUsed   Int                @default(0)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  setupRuns              ProductSetupRun[]
  personaEvidenceBundles PersonaEvidenceBundle[]
  personaSetupRuns       PersonaSetupRun[]

  @@unique([organizationId, productId, version])
  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, productId])
}

/// One Product synthesis workflow over an evidence bundle (Product draft + suggested buyer roles).
/// Historical runs may still contain personaDraftsJson from pre-split prompt versions.
model ProductSetupRun {
  id                     String             @id @default(cuid())
  organizationId         String
  productId              String
  evidenceBundleId       String
  correlationId          String
  status                 ProductSetupStatus @default(SYNTHESIZING)
  productDraftJson       Json?
  messagingDraftJson     Json?
  /// Lightweight SuggestedBuyerRole[] (legacy runs may hold fuller suggested persona cards).
  suggestedPersonasJson  Json?
  /// Legacy field — no longer written by Product synthesis v3+. Kept for history.
  personaDraftsJson      Json?
  synthesisPromptVersion String?
  aiProvider             String?
  aiModel                String?
  errorSafe              String?
  /// Flags in-place approved-product resynthesis (e.g. approvedProductResynthesis).
  userContextJson        Json?
  createdByUserId        String?
  createdAt              DateTime           @default(now())
  completedAt            DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidenceBundle ProductEvidenceBundle @relation(fields: [evidenceBundleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([evidenceBundleId])
  @@index([correlationId])
}

/// Persona-specific research source (not ProductSource).
model PersonaSource {
  id                 String              @id @default(cuid())
  organizationId     String
  productId          String
  personaSetupRunId  String?
  personaId          String?
  sourceType         ProductSourceType
  displayName        String
  originalUrl        String?
  normalizedUrlKey   String?
  filename           String?
  mimeType           String?
  byteSize           Int?
  acquisitionMethod  String
  /// CUSTOMER_EVIDENCE | WEB_EVIDENCE | MODEL_INFERENCE (input material class).
  provenanceClass    String              @default("WEB_EVIDENCE")
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  retrievedAt        DateTime?
  contentHash        String
  status             ProductSourceStatus @default(PENDING)
  errorSafe          String?
  extractedText      String?
  freshnessExpiresAt DateTime?
  metadataJson       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  persona      Persona?     @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([organizationId, contentHash])
  @@index([organizationId])
  @@index([productId])
  @@index([personaId])
  @@index([personaSetupRunId])
  @@index([organizationId, normalizedUrlKey])
}

/// Compact persona research evidence for one Persona setup attempt.
model PersonaEvidenceBundle {
  id                      String             @id @default(cuid())
  organizationId          String
  productId               String
  personaSetupRunId       String?
  version                 Int
  correlationId           String
  status                  PersonaSetupStatus @default(RESEARCHING)
  createdByUserId         String?
  createdAt               DateTime           @default(now())
  normalizedEvidenceJson  Json?
  sourceIdsJson           Json?
  productEvidenceBundleId String?
  webSearchQueriesUsed    Int                @default(0)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productEvidenceBundle ProductEvidenceBundle? @relation(fields: [productEvidenceBundleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([correlationId])
}

/// One Persona research + synthesis run for a single buyer role.
model PersonaSetupRun {
  id                      String             @id @default(cuid())
  organizationId          String
  productId               String
  personaId               String?
  productEvidenceBundleId String
  personaEvidenceBundleId String?
  correlationId           String
  status                  PersonaSetupStatus @default(SYNTHESIZING)
  selectedBuyerRoleJson   Json?
  suggestionKey           String?
  userContextJson         Json?
  personaDraftJson        Json?
  synthesisPromptVersion  String?
  aiProvider              String?
  aiModel                 String?
  errorSafe               String?
  createdByUserId         String?
  createdAt               DateTime           @default(now())
  completedAt             DateTime?

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product               Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  persona               Persona?              @relation(fields: [personaId], references: [id], onDelete: SetNull)
  productEvidenceBundle ProductEvidenceBundle @relation(fields: [productEvidenceBundleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([personaId])
  @@index([correlationId])
}

/// Tenant-owned structured Persona criterion (role/responsibility oriented).
model PersonaCriterion {
  id                   String                @id @default(cuid())
  organizationId       String
  personaId            String
  name                 String
  description          String?
  criterionType        String
  dataType             CriterionDataType
  operator             CriterionOperator
  targetValue          Json?
  minValue             Json?
  maxValue             Json?
  allowedValues        Json?
  importance           CriterionImportance   @default(MEDIUM)
  isRequired           Boolean               @default(false)
  isDisqualifier       Boolean               @default(false)
  /// TITLE_TESTABLE | EVIDENCE_TESTABLE for exclusions; null for non-disqualifiers.
  exclusionTestability ExclusionTestability?
  researchGuidance     String?
  source               CriterionSource       @default(AI_INTERPRETED)
  confidence           ResearchConfidence?
  manuallyEdited       Boolean               @default(false)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  persona      Persona      @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([personaId])
  @@index([organizationId, personaId])
  @@index([organizationId, personaId, sortOrder])
}

model ContactList {
  id               String            @id @default(cuid())
  organizationId   String
  ownerUserId      String
  name             String
  sourceType       ContactListSource @default(UPLOAD)
  originalFilename String?
  totalContacts    Int               @default(0)
  /// Soft-archive: hidden from selectors; scoring history stays attached.
  archivedAt       DateTime?
  /// Rep who created the list. UI filters to current user by default.
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                  User                    @relation("ContactListOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy              User?                   @relation("ContactListCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships            ContactListMembership[]
  scoringRuns            ScoringRun[]
  researchRuns           ResearchRun[]
  /// Contacts soft-archived because this list was their last active list (cascade).
  contactsArchivedByThis Contact[]               @relation("ContactArchivedByList")

  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, createdAt])
  @@index([organizationId, sourceType])
  @@index([organizationId, archivedAt])
  @@index([createdByUserId])
  @@index([organizationId, createdByUserId])
}

/// Org-scoped person. Unique on normalized email when present.
/// Email-less rows are allowed but marked unusable (cannot email/score/suppress).
model Contact {
  id               String                @id @default(cuid())
  organizationId   String
  ownerUserId      String
  /// Suppression/dedupe key. Null when the row has no usable email.
  normalizedEmail  String?
  createdByUserId  String?
  companyId        String?
  firstName        String?
  lastName         String?
  email            String?
  title            String?
  /// Prior title when an import overwrote title (persona-matching audit).
  previousTitle    String?
  titleChangedAt   DateTime?
  company          String?
  companyWebsite   String?
  industry         String?
  employeeCount    Int?
  revenue          Decimal?              @db.Decimal(14, 2)
  location         String?
  linkedinUrl      String?
  phone            String?
  rawData          Json?
  /// Soft-archive: used when campaign/send history blocks hard delete,
  /// or when cascaded from archiving a list that was the contact's last active list.
  archivedAt       DateTime?
  /// Null when not archived. DIRECT = contact archive/delete path; LIST_CASCADE = list archive.
  archiveReason    ContactArchiveReason?
  /// When archiveReason is LIST_CASCADE, the list that triggered the cascade (for precise restore).
  archivedByListId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User                    @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy        User?                   @relation("ContactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  companyRecord    Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  archivedByList   ContactList?            @relation("ContactArchivedByList", fields: [archivedByListId], references: [id], onDelete: SetNull)
  memberships      ContactListMembership[]
  scores             ContactScore[]
  campaignContacts   CampaignContact[]
  contactResearch    ContactResearch[]
  applicationAssets  ApplicationAsset[]
  interviewStages    InterviewStageInterviewer[]

  @@unique([organizationId, ownerUserId, normalizedEmail])
  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([organizationId, archivedAt])
  @@index([organizationId, archiveReason, archivedByListId])
  @@index([companyId])
  @@index([organizationId, companyId])
  @@index([createdByUserId])
  @@index([archivedByListId])
}

model ContactListMembership {
  id             String   @id @default(cuid())
  organizationId String
  contactListId  String
  contactId      String
  addedAt        DateTime @default(now())
  addedByUserId  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactList  ContactList  @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation("ContactMembershipAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([contactListId, contactId])
  @@index([organizationId])
  @@index([contactListId])
  @@index([contactId])
  @@index([organizationId, contactId])
  @@index([addedByUserId])
}

/// Durable merge audit from Contact normalization. Ids are plain strings — no FK
/// cascade — so rows survive after loser contacts are deleted.
model ContactMergeAudit {
  id              String   @id @default(cuid())
  organizationId  String
  winnerContactId String
  loserContactId  String
  normalizedEmail String?
  /// Snapshot of loser fields and which winner fields were overwritten.
  mergePayload    Json
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, winnerContactId])
  @@index([organizationId, loserContactId])
  @@index([organizationId, normalizedEmail])
  @@index([createdAt])
}

model Company {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  normalizedName   String
  website          String?
  normalizedDomain String?
  industry         String?
  employeeCount    Int?
  revenue          Decimal? @db.Decimal(14, 2)
  location         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  research        CompanyResearch[]
  jobRequirements JobRequirement[]

  @@unique([organizationId, normalizedDomain])
  @@index([organizationId])
  @@index([organizationId, normalizedName])
  @@index([organizationId, normalizedDomain])
}

model CompanyResearch {
  id                      String                @id @default(cuid())
  organizationId          String
  companyId               String
  status                  CompanyResearchStatus @default(NOT_STARTED)
  researchMethod          ResearchMethod        @default(AUTOMATED)
  companySummary          String?
  whatTheySell            String?
  customerTypes           Json?
  primaryMarkets          Json?
  businessModel           String?
  estimatedAov            String?
  aovReasoning            String?
  companySizeContext      String?
  relevantTechnologies    Json?
  buyingSignals           Json?
  /// Hiring and growth signals from job-seeker company research. Never copied into buyingSignals.
  hiringSignals           Json?
  riskSignals             Json?
  /// True when automated research could not safely match evidence to this company.
  identityAmbiguous       Boolean               @default(false)
  researchConfidence      ResearchConfidence?
  sourceCount             Int                   @default(0)
  researchSources         Json?
  researchedAt            DateTime?
  expiresAt               DateTime?
  /// Automated research provenance — never stores API keys.
  aiProvider              String?
  aiModel                 String?
  aiModelUrlIdentifier    String?
  promptVersion           String?
  /// Safe usage metadata from research provider (no pricing calculation).
  inputTokens             Int?
  outputTokens            Int?
  webSearchCallCount      Int?
  researchDurationMs      Int?
  /// LLM synthesis stages executed (prefetch + web-search passes).
  searchStagesUsed        Int?
  /// Why progressive search stopped (sufficient, max_queries, etc.).
  researchStoppedReason   String?
  /// Per-stage wall times — array of { stage, webSearchEnabled, durationMs }.
  researchStageTimings    Json?
  /// User who initiated this research run (metering). Ownership remains Organization.
  researchedByUserId      String?
  /// Immutable first introducer of this company into the org research pool.
  /// Set only when the first CompanyResearch row for (org, company) is created.
  /// Null on legacy rows = no per-user net-new attribution.
  firstResearchedByUserId String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  researchedBy      User?        @relation("ResearchInitiatedBy", fields: [researchedByUserId], references: [id], onDelete: SetNull)
  firstResearchedBy User?        @relation("ResearchFirstIntroducedBy", fields: [firstResearchedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, companyId])
  @@index([companyId])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@index([researchedByUserId])
  @@index([firstResearchedByUserId])
  @@index([organizationId, firstResearchedByUserId])
}

/// Contact-level role research (separate from CompanyResearch). Answers "what are they responsible for?"
model ContactResearch {
  id                   String                @id @default(cuid())
  organizationId       String
  contactId            String
  status               ContactResearchStatus @default(NOT_STARTED)
  researchMethod       ResearchMethod        @default(AUTOMATED)
  confidence           ResearchConfidence?
  currentTitle         String?
  roleSummary          String?
  responsibilities     Json?
  ownershipAreas       Json?
  professionalSignals  Json?
  negativeRoleSignals  Json?
  researchSources      Json?
  researchedAt         DateTime?
  expiresAt            DateTime?
  aiProvider           String?
  aiModel              String?
  aiModelUrlIdentifier String?
  promptVersion        String?
  inputTokens          Int?
  outputTokens         Int?
  webSearchCallCount   Int?
  researchDurationMs   Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organizationId, contactId])
  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, status])
  @@index([expiresAt])
}

/// Durable batch ledger for automated company research on a contact list.
model ResearchRun {
  id                       String            @id @default(cuid())
  organizationId           String
  /// List-scoped batch. Null when this run is application employer research.
  contactListId            String?
  /// Application-scoped single-company research. Null for list batches.
  campaignId               String?
  scoringRunId             String?
  status                   ResearchRunStatus @default(PENDING)
  forceRefresh             Boolean           @default(false)
  failuresOnly             Boolean           @default(false)
  retryOfRunId             String?
  totalCompanies           Int               @default(0)
  completedCount           Int               @default(0)
  failedCount              Int               @default(0)
  skippedFreshCount        Int               @default(0)
  quotaBlockedCount        Int               @default(0)
  /// Company ids that failed during this run (for failures-only retry).
  failedCompanyIds         Json?
  /// Company ids fully handled in this run (for worker resume).
  processedCompanyIds      Json?
  /// Company ids blocked by quota during this run.
  quotaBlockedCompanyIds   Json?
  quotaBlockedCompanyNames Json?
  currentCompanyId         String?
  currentCompanyName       String?
  lastError                String?
  initiatedByUserId        String?
  workerHeartbeatAt        DateTime?
  /// Set on clean worker shutdown (SIGTERM) so another worker can reclaim immediately.
  pausedAt                 DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactList  ContactList?  @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scoringRun   ScoringRun?   @relation(fields: [scoringRunId], references: [id], onDelete: SetNull)
  initiatedBy  User?         @relation("ResearchRunInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  retryOf      ResearchRun?  @relation("ResearchRunRetry", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries      ResearchRun[] @relation("ResearchRunRetry")

  @@index([organizationId])
  @@index([contactListId])
  @@index([campaignId])
  @@index([organizationId, contactListId, status])
  @@index([organizationId, campaignId, status])
  @@index([status, workerHeartbeatAt])
  @@index([scoringRunId])
  @@index([initiatedByUserId])
}

/// Application-scoped generation work processed by the research worker.
model ApplicationJob {
  id                String               @id @default(cuid())
  organizationId    String
  campaignId        String
  type              ApplicationJobType
  status            ApplicationJobStatus @default(PENDING)
  /// Persona, contact, asset type, or interview stage this job targets.
  targetId          String?
  error             String?
  attempt           Int                  @default(0)
  maxAttempts       Int                  @default(3)
  payload           Json?
  initiatedByUserId String?
  workerHeartbeatAt DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  initiatedBy  User?        @relation("ApplicationJobInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([organizationId, campaignId, type, status])
  @@index([campaignId, type, targetId, status])
  @@index([status, workerHeartbeatAt])
  @@index([initiatedByUserId])
}

model ScoringRun {
  id               String           @id @default(cuid())
  organizationId   String
  contactListId    String
  productId        String
  icpId            String
  /// Null means the run scores against every product persona (see personaSnapshots).
  personaId        String?
  /// Display name when started from a campaign (e.g. "Campaign · List").
  label            String?
  /// Campaign that triggered this run; used for Back to Campaign navigation.
  sourceCampaignId String?
  status           ScoringRunStatus @default(PENDING)
  totalContacts    Int              @default(0)
  scoredContacts   Int              @default(0)
  productSnapshot  Json
  icpSnapshot      Json
  /// Single-persona audit snapshot. All-persona runs still store the first snapshot here.
  personaSnapshot  Json
  /// Snapshots for every persona in the run. Length 1 for a single-persona run.
  personaSnapshots Json             @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactList            ContactList                   @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  product                Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  icp                    Icp                           @relation(fields: [icpId], references: [id], onDelete: Restrict)
  persona                Persona?                      @relation(fields: [personaId], references: [id], onDelete: Restrict)
  sourceCampaign         Campaign?                     @relation(fields: [sourceCampaignId], references: [id], onDelete: SetNull)
  scores                 ContactScore[]
  qualificationOverrides QualificationBucketOverride[]
  titleSuggestions       TitleSuggestion[]
  researchRuns           ResearchRun[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([contactListId])
  @@index([organizationId, contactListId])
  @@index([productId])
  @@index([icpId])
  @@index([personaId])
  @@index([sourceCampaignId])
}

/// Distinct unmatched job titles from an all-personas scoring run, with an optional AI proposal.
model TitleSuggestion {
  id                  String                @id @default(cuid())
  organizationId      String
  scoringRunId        String
  productId           String
  unmatchedTitle      String
  normalizedTitle     String
  contactCount        Int
  proposedPersonaId   String?
  proposedPersonaName String?
  confidence          String?
  reasoning           String?
  status              TitleSuggestionStatus @default(PENDING)
  resolvedPersonaId   String?
  resolvedAt          DateTime?
  resolvedById        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoringRun   ScoringRun   @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  resolvedBy   User?        @relation("TitleSuggestionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([scoringRunId, normalizedTitle])
  @@index([organizationId])
  @@index([organizationId, scoringRunId])
  @@index([organizationId, productId, status])
  @@index([productId])
}

/// Product-level dismissed titles so the same unmatched title is not re-proposed.
model ProductTitleDismissal {
  id              String   @id @default(cuid())
  organizationId  String
  productId       String
  normalizedTitle String
  unmatchedTitle  String
  dismissedById   String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  dismissedBy  User?        @relation("ProductTitleDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, productId, normalizedTitle])
  @@index([organizationId])
  @@index([productId])
}

model ContactScore {
  id                     String               @id @default(cuid())
  organizationId         String
  contactId              String
  scoringRunId           String
  scoringStatus          ContactScoringStatus @default(PENDING)
  overallScore           Int?
  icpScore               Int?
  personaScore           Int?
  companyScore           Int?
  productRelevanceScore  Int?
  scoreLabel             ScoreLabel?
  companySummary         String?
  whatTheySell           String?
  estimatedAov           String?
  aovReasoning           String?
  fitStrengths           Json?
  fitRisks               Json?
  disqualifiers          Json?
  reasoning              String?
  recommendedAction      String?
  researchStatus         ResearchStatus       @default(NOT_STARTED)
  researchSources        Json?
  researchedAt           DateTime?
  /// Provenance: which CompanyResearch version informed this score.
  companyResearchId      String?
  companyResearchAt      DateTime?
  /// Provenance: which ContactResearch version informed this score.
  contactResearchId      String?
  contactResearchAt      DateTime?
  /// Dynamic per-criterion assessments (auditability for criteria-driven scoring).
  criterionAssessments   Json?
  /// Validated structured assessment used to calculate scores (auditability).
  assessmentData         Json?
  aiProvider             String?
  aiModel                String?
  /// Sanitized model endpoint identifier — never includes API keys or credentials.
  aiModelUrlIdentifier   String?
  promptVersion          String?
  scoringLogicVersion    String?
  scoredAt               DateTime?
  scoringError           String?
  /// Best-matching persona for this contact when the run covers several personas.
  matchedPersonaId       String?
  matchedPersonaSnapshot Json?
  /// Per-persona gate + score outcomes for audit (one ContactScore row per contact).
  personaAssessments     Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  scoringRun     ScoringRun   @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  matchedPersona Persona?     @relation("ContactScoreMatchedPersona", fields: [matchedPersonaId], references: [id], onDelete: SetNull)

  @@unique([scoringRunId, contactId])
  @@index([organizationId])
  @@index([organizationId, contactId])
  @@index([contactId])
  @@index([scoringRunId])
  @@index([organizationId, scoringRunId])
  @@index([organizationId, scoreLabel])
  @@index([organizationId, researchStatus])
  @@index([organizationId, scoringStatus])
  @@index([matchedPersonaId])
}

model QualificationBucketOverride {
  id             String                      @id @default(cuid())
  organizationId String
  scoringRunId   String
  targetType     QualificationOverrideTarget
  targetId       String
  bucket         QualificationBucket
  overriddenById String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoringRun   ScoringRun   @relation(fields: [scoringRunId], references: [id], onDelete: Cascade)
  overriddenBy User         @relation(fields: [overriddenById], references: [id], onDelete: Restrict)

  @@unique([organizationId, scoringRunId, targetType, targetId])
  @@index([organizationId])
  @@index([scoringRunId])
  @@index([overriddenById])
}

enum CampaignVisibility {
  PERSONAL
  SHARED
}

model Campaign {
  id                  String             @id @default(cuid())
  organizationId      String
  /// Owning user. Managers may inspect another user's campaign but only its owner may modify it.
  ownerUserId         String
  visibility          CampaignVisibility @default(PERSONAL)
  name                String
  productId           String
  icpId               String
  personaId           String?
  /// Legacy optional link to Offer table. New campaigns use offer* fields below.
  offerId             String?
  offerName           String?
  offerDescription    String?
  offerCta            String?
  offerNotes          String?
  offerValidationJson Json?
  offerValidationHash String?
  emailLength         EmailLength        @default(MEDIUM)
  emailGuidance       String?
  /// Date the seeker marked this application Applied. Null until marked.
  appliedAt           DateTime?
  /// Seeker-facing application progress. First interview stage sets INTERVIEWING.
  applicationProgress ApplicationProgress?
  status              CampaignStatus     @default(DRAFT)
  /// Soft-archive: hidden from home/list by default; history intact, read-only.
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User                 @relation("CampaignOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  product             Product              @relation(fields: [productId], references: [id])
  icp                 Icp                  @relation(fields: [icpId], references: [id])
  persona             Persona?             @relation(fields: [personaId], references: [id])
  offer               Offer?               @relation(fields: [offerId], references: [id])
  contacts            CampaignContact[]
  personasInPlay      CampaignPersona[]
  sourcedScoringRuns  ScoringRun[]
  jobRequirement      JobRequirement?
  applicationFit      ApplicationFit?
  hiringTeamRoles     Persona[]            @relation("ApplicationHiringTeam")
  consultationSession ConsultationSession?
  applicationSummary  ApplicationSummary?
  applicationAssets   ApplicationAsset[]
  interviewStages     InterviewStage[]
  researchRuns        ResearchRun[]
  presentationPlans   ApplicationPresentationPlan[]
  applicationJobs     ApplicationJob[]
  /// Harper-written next step for the current application state.
  nextStepText        String?
  nextStepStateKey    String?
  /// Seeker FACT: why they want to work at this company.
  whyThisCompany      String?
  /// Seeker-pasted employer facts or interests used as a research source.
  companyResearchNotes String?
  /// Latest viewed result key per application step. Missing keys mean unseen.
  workspaceSeenJson   Json?

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, visibility])
  @@index([ownerUserId])
  @@index([productId])
  @@index([icpId])
  @@index([personaId])
  @@index([offerId])
}

/// Structured job requirement parsed from one pasted posting. One per application.
model JobRequirement {
  id                   String                 @id @default(cuid())
  organizationId       String
  campaignId           String                 @unique
  rawText              String
  /// What the seeker learned about this job after the original posting.
  seekerLearnedNotes   String?
  postingUrl           String?
  title                String?
  companyName          String?
  location             String?
  workArrangement      String?
  employmentType       String?
  seniority            String?
  compensationRange    String?
  reportingLine        String?
  responsibilities     Json?
  requiredItems        Json?
  preferredItems       Json?
  scorecardJson        Json
  /// Named people captured from the posting (FACT). Shape: NamedJobContact[].
  namedContactsJson    Json?
  employerDisposition        JobEmployerDisposition @default(IDENTIFIED)
  employerSkipReason         String?
  suppliedEmployerName       String?
  suppliedEmployerWebsite    String?
  identityVerificationJson   Json?
  identityConfirmation       IdentityConfirmation   @default(PENDING)
  companyId                  String?
  parserPromptVersion  String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId])
}

/// Employer fit for one application. A mismatch is a signal; nothing downstream reads it as a gate.
model ApplicationFit {
  id                          String               @id @default(cuid())
  organizationId              String
  campaignId                  String               @unique
  icpId                       String
  interpretationPromptVersion String?
  bucket                      QualificationBucket
  outcomesJson                Json
  computedAt                  DateTime
  companyResearchId           String?
  companyResearchUpdatedAt    DateTime?
  icpUpdatedAt                DateTime
  stale                       Boolean              @default(false)
  staleReason                 String?
  overrideBucket              QualificationBucket?
  overrideReason              String?
  overriddenAt                DateTime?
  overriddenByUserId          String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  icp          Icp          @relation(fields: [icpId], references: [id], onDelete: Restrict)
  overriddenBy User?        @relation("ApplicationFitOverride", fields: [overriddenByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([icpId])
  @@index([overriddenByUserId])
}

enum ConsultationStatus {
  IN_PROGRESS
  PAUSED
  SKIPPED
  DONE
}

enum ConsultationGenerationStatus {
  READY
  GENERATING
  FAILED
}

enum ConsultationSpeaker {
  CONSULTANT
  SEEKER
}

enum EvidenceStrength {
  STRONG
  PARTIAL
  NONE
}

enum GapStrategy {
  PROVE_WITH_STORY
  REFRAME_ADJACENT
  ACKNOWLEDGE
}

enum ConsultationProposalStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum ConsultationProposalKind {
  FACT
  STORY
}

enum ConsultationStatementKind {
  INTERVIEW_ANSWER
  RESUME_BULLET
}

enum ConsultationStatementStatus {
  DRAFT
  APPROVED
}

enum ApplicationAssetType {
  RESUME
  COVER_LETTER
  EMAIL
  LINKEDIN_CONNECTION_NOTE
  LINKEDIN_INMAIL
}

enum ApplicationPresentationPlanType {
  RESUME
  COVER_LETTER
}

enum ApplicationPresentationPlanStatus {
  DRAFT
  ACCEPTED
}

enum ApplicationOutreachPurpose {
  PROACTIVE
  FOLLOW_UP
  THANK_YOU
  CHECK_IN
}

enum ApplicationAssetStatus {
  DRAFT
  APPROVED
}

/// One consultation per application. Answers stay verbatim. Nothing is written to the Personal Profile until confirmed.
model ConsultationSession {
  id               String                       @id @default(cuid())
  organizationId   String
  campaignId       String                       @unique
  productId        String
  status           ConsultationStatus           @default(IN_PROGRESS)
  generationStatus ConsultationGenerationStatus @default(READY)
  generationError  String?
  promptVersion    String
  /// Model-written coaching commentary. Generation errors are stored separately.
  coachNote        String?
  /// Model-written opening briefing: overall, angles, gaps, and story plan.
  briefingJson     Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  turns        ConsultationTurn[]
  assessments  ConsultationAssessment[]
  proposals    ConsultationProposal[]
  statements   ConsultationStatement[]

  @@index([organizationId])
  @@index([productId])
}

model ConsultationTurn {
  id                  String              @id @default(cuid())
  organizationId      String
  sessionId           String
  sequence            Int
  speaker             ConsultationSpeaker
  /// Seeker answers are stored verbatim.
  body                String
  skipped             Boolean             @default(false)
  /// Requirement key this turn is about. Null for session-level notes.
  targetKey           String?
  followUp            Boolean             @default(false)
  /// Seeker turns are the seeker's own words. Voice may use them later.
  seekerAuthored      Boolean             @default(false)
  /// Model extraction plus guardrail drops. Never used as seeker-authored evidence.
  analysisJson        Json?
  /// Model-written requirement interpretation and persona-grounded who-cares note.
  questionContextJson Json?
  /// REPLY | CHANGE | NOT_ACCURATE | CLOSING. Null for legacy turns.
  intent              String?
  createdAt           DateTime            @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ConsultationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proposals    ConsultationProposal[]
  statements   ConsultationStatement[]

  @@unique([sessionId, sequence])
  @@index([organizationId])
  @@index([sessionId])
}

model ConsultationAssessment {
  id                        String           @id @default(cuid())
  organizationId            String
  sessionId                 String
  targetKey                 String
  kind                      String
  text                      String
  strength                  EvidenceStrength
  supportingFactIds         Json
  strategy                  GapStrategy?
  /// Model-written reasoning and item-specific coaching.
  explanation               String?
  strategyText              String?
  /// Grounding downgrades and deterministic years calculation.
  verificationJson          Json?
  experienceCalculationJson Json?
  updatedAt                 DateTime         @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, targetKey])
  @@index([organizationId])
}

model ConsultationProposal {
  id              String                     @id @default(cuid())
  organizationId  String
  sessionId       String
  turnId          String
  status          ConsultationProposalStatus @default(PENDING)
  kind            ConsultationProposalKind
  text            String
  storyJson       Json?
  competencyLinks Json?
  profileItemId   String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn         ConsultationTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sessionId])
  @@index([turnId])
}

model ConsultationStatement {
  id                String                      @id @default(cuid())
  organizationId    String
  sessionId         String
  turnId            String
  kind              ConsultationStatementKind
  status            ConsultationStatementStatus @default(DRAFT)
  content           String
  /// Model-written coaching shown separately from the seeker's reusable statement.
  strengtheningNote String?
  groundingJson     Json
  promptVersion     String
  generation        Int                         @default(1)
  approvedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn         ConsultationTurn    @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, kind])
  @@index([organizationId])
  @@index([sessionId])
  @@index([status])
}

/// STAR story bank on the Personal Profile. Reused by later applications.
model ProfileStory {
  id                        String    @id @default(cuid())
  organizationId            String
  productId                 String
  situation                 String
  task                      String
  action                    String
  result                    String
  competencyLinks           Json
  consultationTurnId        String
  seekerAuthored            Boolean   @default(true)
  /// Verbatim seeker answer plus separately approved reusable statements.
  verbatimAnswer            String?
  interviewAnswer           String?
  resumeBullet              String?
  interviewAnswerApprovedAt DateTime?
  resumeBulletApprovedAt    DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([consultationTurnId])
}

/// Generated interview cheat-sheet guidance for one application.
/// Stored-data sections are assembled live; only model-written guidance is persisted.
model ApplicationSummary {
  id              String                       @id @default(cuid())
  organizationId  String
  campaignId      String                       @unique
  status          ConsultationGenerationStatus @default(GENERATING)
  guidanceJson    Json?
  sourceHash      String?
  promptVersion   String
  generationError String?
  generatedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

/// Versioned resume or cover letter for one application. DOCX is rendered on demand.
model ApplicationAsset {
  id                String                      @id @default(cuid())
  organizationId    String
  campaignId        String
  type              ApplicationAssetType
  personaId         String?
  contactId         String?
  purpose           ApplicationOutreachPurpose?
  followUpToAssetId String?
  interviewStageId  String?
  sentAt            DateTime?
  emailLength       EmailLength?
  /// Versioning key. Resume/cover letter use the type. Outreach uses type:persona:contact:purpose.
  groupKey          String                      @default("default")
  version           Int
  contentJson       Json
  claimTraceJson    Json
  guidance          String?
  promptVersion     String
  staleReason       String?
  status            ApplicationAssetStatus      @default(DRAFT)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  persona      Persona?           @relation(fields: [personaId], references: [id], onDelete: SetNull)
  contact      Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUpTo   ApplicationAsset?  @relation("OutreachFollowUp", fields: [followUpToAssetId], references: [id], onDelete: SetNull)
  followUps    ApplicationAsset[] @relation("OutreachFollowUp")
  interviewStage InterviewStage? @relation(fields: [interviewStageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, groupKey, version])
  @@index([organizationId])
  @@index([campaignId, type])
  @@index([campaignId, groupKey])
  @@index([personaId])
  @@index([contactId])
  @@index([followUpToAssetId])
  @@index([interviewStageId])
  @@index([status])
  @@index([sentAt])
}

/// Harper-written resume or cover-letter recommendation. Generation waits for accept.
model ApplicationPresentationPlan {
  id               String                            @id @default(cuid())
  organizationId   String
  campaignId       String
  type             ApplicationPresentationPlanType
  status           ApplicationPresentationPlanStatus @default(DRAFT)
  planJson         Json
  adjustmentNote   String?
  promptVersion    String
  acceptedAt       DateTime?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, type])
  @@index([organizationId])
  @@index([campaignId])
}

model InterviewStage {
  id                   String                 @id @default(cuid())
  organizationId       String
  campaignId           String
  sortOrder            Int
  type                 InterviewStageType
  scheduledAt          DateTime
  format               InterviewFormat
  notesBefore          String?
  notesAfter           String?
  expectedDecisionAt   DateTime?
  outcome              InterviewStageOutcome?
  consultationOfferJson Json?
  thankYouClarifyJson  Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign      Campaign                     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  interviewers  InterviewStageInterviewer[]
  guide         InterviewStageGuide?
  outreachAssets ApplicationAsset[]

  @@unique([campaignId, sortOrder])
  @@index([organizationId])
  @@index([campaignId])
  @@index([scheduledAt])
}

model InterviewStageInterviewer {
  id             String   @id @default(cuid())
  organizationId String
  stageId        String
  contactId      String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        InterviewStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact      Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([stageId, contactId])
  @@index([organizationId])
  @@index([contactId])
}

model InterviewStageGuide {
  id                       String                       @id @default(cuid())
  organizationId           String
  stageId                  String                       @unique
  status                   ConsultationGenerationStatus @default(GENERATING)
  clarifyingQuestionsJson  Json?
  clarifyingAnswersJson    Json?
  clarifyingSkipped        Boolean                      @default(false)
  contentJson              Json?
  sourceHash               String?
  promptVersion            String
  generationError          String?
  generatedAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        InterviewStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

/// Personas a campaign will email. Empty means all personas for the product.
/// Campaign.personaId remains as a legacy single-persona fallback.
model CampaignPersona {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  personaId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  persona      Persona      @relation(fields: [personaId], references: [id], onDelete: Restrict)

  @@unique([organizationId, campaignId, personaId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([personaId])
}

model CampaignContact {
  id                      String                @id @default(cuid())
  organizationId          String
  campaignId              String
  contactId               String
  selected                Boolean               @default(true)
  status                  CampaignContactStatus @default(PENDING)
  /// When non-null, automated follow-up cadence is stopped for this contact.
  sequenceStoppedAt       DateTime?
  sequenceStoppedReason   SequenceStopReason?
  sequenceStoppedByUserId String?
  /// Materialized next follow-up due date. Null when cadence inactive or no prior send.
  nextDueAt               DateTime?
  /// Rep-confirmed persona for this contact in this campaign (explicit decision).
  chosenPersonaId         String?
  /// True when the role came from the posting or the seeker confirmed it.
  roleConfirmed           Boolean               @default(false)
  /// Pasted LinkedIn profile text. Never fetched or scraped.
  linkedInProfileText     String?
  linkedInExtractedJson   Json?
  individualProfileJson   Json?
  individualProfileStatus ApplicationJobStatus?
  individualProfileError  String?
  /// Harper per-person interview prep. Null until a person is linked to a role or stage.
  personPrepStatus        String?
  personPrepOpening       String?
  personPrepAnswersJson   Json?
  personPrepOfferedAt     DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  chosenPersona     Persona?          @relation("CampaignContactChosenPersona", fields: [chosenPersonaId], references: [id], onDelete: SetNull)
  sequenceStoppedBy User?             @relation("SequenceStoppedBy", fields: [sequenceStoppedByUserId], references: [id], onDelete: SetNull)
  emailDrafts       EmailDraft[]
  sendRecords       EmailSendRecord[]

  @@unique([organizationId, campaignId, contactId])
  @@index([organizationId])
  @@index([organizationId, campaignId])
  @@index([organizationId, campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@index([organizationId, nextDueAt])
  @@index([nextDueAt])
  @@index([chosenPersonaId])
}

model EmailDraft {
  id                       String               @id @default(cuid())
  organizationId           String
  campaignContactId        String
  sequenceNumber           Int
  subject                  String?
  body                     String?
  generatedBody            String?
  status                   EmailDraftStatus     @default(NOT_CREATED)
  source                   EmailDraftSource     @default(AI)
  /// False for AI_LOOKAHEAD drafts until the rep opens the contact (quota charged then).
  generationQuotaCommitted Boolean              @default(true)
  kind                     EmailDraftKind       @default(INITIAL)
  replyClassification      ReplyClassification?
  prospectReplyText        String?
  referralSuggested        Boolean              @default(false)
  inReplyToDraftId         String?
  emailLength              EmailLength?
  personaId                String?
  personalizationTier      String?
  personalizationSources   String?
  /// Claim-guard violations from the last AI generation (null when clean).
  claimConflictsJson       Json?
  approvedAt               DateTime?
  sentAt                   DateTime?
  sentMethod               EmailSentMethod?
  sentByUserId             String?
  sendAttemptId            String?
  sendAttemptStartedAt     DateTime?
  /// Rep-provided context when handling a prospect reply (They Replied flow).
  repReplyContext          String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact   @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  inReplyTo       EmailDraft?       @relation("EmailDraftReplies", fields: [inReplyToDraftId], references: [id], onDelete: SetNull)
  replyDrafts     EmailDraft[]      @relation("EmailDraftReplies")
  sentByUser      User?             @relation("EmailDraftSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  sendRecords     EmailSendRecord[]

  @@unique([organizationId, campaignContactId, sequenceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([campaignContactId])
  @@index([inReplyToDraftId])
  @@index([sentByUserId])
  @@index([status])
}

model EmailSendRecord {
  id                String                @id @default(cuid())
  organizationId    String
  emailDraftId      String
  campaignContactId String
  recipient         String
  subject           String
  generatedBody     String
  finalBody         String
  sentByUserId      String
  method            EmailSendRecordMethod
  occurredAt        DateTime              @default(now())
  providerMessageId String?
  providerRequestId String?
  createdAt         DateTime              @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailDraft      EmailDraft      @relation(fields: [emailDraftId], references: [id], onDelete: Cascade)
  campaignContact CampaignContact @relation(fields: [campaignContactId], references: [id], onDelete: Cascade)
  sentByUser      User            @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, sentByUserId, occurredAt])
  @@index([emailDraftId])
  @@index([campaignContactId])
  @@index([providerMessageId])
}

/// Organization-level email suppression. Keyed on normalized email so a later
/// list upload cannot resurrect an opted-out address. Cross-tenant unique
/// (organizationId, normalizedEmail) — org A never affects org B.
model EmailSuppression {
  id              String                 @id @default(cuid())
  organizationId  String
  normalizedEmail String
  reason          EmailSuppressionReason
  status          EmailSuppressionStatus @default(ACTIVE)
  note            String?
  suppressedById  String
  suppressedAt    DateTime               @default(now())
  releasedById    String?
  releasedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suppressedBy User         @relation("EmailSuppressedBy", fields: [suppressedById], references: [id], onDelete: Restrict)
  releasedBy   User?        @relation("EmailReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, normalizedEmail])
  @@index([organizationId, status])
  @@index([organizationId, normalizedEmail])
  @@index([suppressedById])
  @@index([releasedById])
}

model AuthUser {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  firstName     String        @default("")
  lastName      String        @default("")
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@unique([email])
  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  /// Better Auth 1.7+ account identity scope (e.g. local:credential).
  issuer                String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

model AdminAuditEvent {
  id             String           @id @default(cuid())
  action         AdminAuditAction
  actorUserId    String?
  organizationId String?
  targetUserId   String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorUserId])
  @@index([organizationId])
  @@index([createdAt])
}

/// Published or draft End User License Agreement / Terms of Service text.
/// At most one row should have publishedAt set; enforced in publish action.
model EulaVersion {
  id              String    @id @default(cuid())
  versionNumber   Int       @unique
  content         String
  createdAt       DateTime  @default(now())
  publishedAt     DateTime?
  createdByUserId String?

  createdBy   User?                @relation("EulaVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptances UserEulaAcceptance[]

  @@index([publishedAt])
  @@index([createdByUserId])
}

/// Per-user acceptance of a specific EULA version.
model UserEulaAcceptance {
  id            String   @id @default(cuid())
  userId        String
  eulaVersionId String
  acceptedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eulaVersion EulaVersion @relation(fields: [eulaVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, eulaVersionId])
  @@index([eulaVersionId])
  @@index([userId])
}

/// Global ops configuration (one row per namespaced key). SUPER_ADMIN writable.
/// Value JSON is key-specific and validated in app code — e.g. billing.trial.
model PlatformSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  updatedBy User? @relation("PlatformSettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

model TransactionalEmailTemplate {
  id              String                        @id @default(cuid())
  templateKey     TransactionalEmailTemplateKey @unique
  displayName     String
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String
  enabled         Boolean                       @default(true)
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
}

model TransactionalEmailTemplateBaseline {
  id              String                        @id @default(cuid())
  templateKey     TransactionalEmailTemplateKey @unique
  displayName     String
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String
  createdAt       DateTime                      @default(now())
}

model TransactionalEmailEvent {
  id                       String                        @id @default(cuid())
  userId                   String?
  organizationId           String?
  templateKey              TransactionalEmailTemplateKey
  templateVersion          Int?
  recipientEmailNormalized String
  provider                 String
  providerMessageId        String?
  status                   TransactionalEmailStatus
  failureCategory          String?
  retryCount               Int                           @default(0)
  idempotencyKey           String?
  createdAt                DateTime                      @default(now())
  sentAt                   DateTime?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([templateKey])
  @@index([recipientEmailNormalized])
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model SupportTicket {
  id                String              @id @default(cuid())
  organizationId    String?
  submittedByUserId String?
  subject           String              @db.VarChar(120)
  description       String              @db.Text
  status            SupportTicketStatus @default(OPEN)
  sourcePath        String              @db.VarChar(500)
  userAgent         String?             @db.VarChar(1000)
  organizationName  String              @db.VarChar(200)
  submittedByName   String?             @db.VarChar(200)
  submittedByEmail  String              @db.VarChar(320)
  planCode          String?             @db.VarChar(50)
  billingStatus     BillingStatus?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  submittedBy  User?               @relation("SupportTicketSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  notes        SupportTicketNote[]

  @@index([status, createdAt])
  @@index([organizationId])
  @@index([submittedByUserId])
  @@index([createdAt])
}

model SupportTicketNote {
  id              String   @id @default(cuid())
  supportTicketId String
  authorUserId    String?
  body            String   @db.Text
  createdAt       DateTime @default(now())

  supportTicket SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  author        User?         @relation("SupportTicketNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([supportTicketId, createdAt])
  @@index([authorUserId])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([bucketKey])
}
