{
  "name": "email-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -e .env -- prisma migrate deploy",
    "render:pre-deploy": "node scripts/render-pre-deploy.mjs",
    "research:worker": "dotenv -e .env.local -e .env -- tsx --conditions=react-server scripts/research-worker.ts",
    "research:worker:render": "tsx --conditions=react-server scripts/research-worker.ts",
    "db:studio": "dotenv -e .env.local -e .env -- prisma studio",
    "db:safety": "node scripts/db-safety-check.mjs",
    "db:up": "node scripts/start-local-postgres.mjs",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:test:down": "docker compose down",
    "db:test:migrate": "tsx --conditions=react-server scripts/migrate-test-db.ts",
    "db:contact-collapse-preview": "dotenv -e .env.local -e .env -- tsx --conditions=react-server scripts/collapse-contacts.ts --preview",
    "db:contact-collapse-apply": "dotenv -e .env.local -e .env -- tsx --conditions=react-server scripts/collapse-contacts.ts --apply",
    "db:personal-ownership-report": "dotenv -e .env.local -e .env -- node scripts/report-personal-work-ownership.mjs",
    "db:test:pollution-report": "tsx --conditions=react-server scripts/report-test-pollution.mjs",
    "db:seed": "dotenv -e .env.local -e .env -- tsx --conditions=react-server prisma/seed.ts",
    "auth:bootstrap": "dotenv -e .env.local -e .env -- tsx --conditions=react-server scripts/auth-bootstrap.ts",
    "platform:bootstrap-admin": "dotenv -e .env.local -e .env -- tsx --conditions=react-server scripts/platform-bootstrap-admin.ts",
    "platform:provision-super-admin": "tsx --conditions=react-server scripts/platform-provision-super-admin.ts",
    "billing:create-referral-coupons": "dotenv -e .env.local -e .env -- tsx --conditions=react-server scripts/create-referral-coupons.ts",
    "test": "vitest run",
    "test:smoke": "tsx --conditions=react-server scripts/smoke-routes.ts",
    "typecheck:scripts": "tsc -p scripts/ad-hoc/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.1",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.1",
    "jose": "^6.2.10",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
